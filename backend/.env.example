# Backend values override the existing root VITE_SUPABASE_* development values.
# Copy this file to backend/.env; never commit credentials.
SUPABASE_URL=
SUPABASE_PUBLISHABLE_KEY=
CORS_ORIGINS=["http://localhost:8080","http://127.0.0.1:8080","http://localhost:5173","http://127.0.0.1:5173"]
REQUEST_TIMEOUT_SECONDS=5
# Opt in to explicitly labelled, deterministic simulation. No AI API calls.
CONVERSATION_MODE=disabled
STORY_GENERATION_MODE=disabled
