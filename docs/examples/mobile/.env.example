# Documentation template only. Copy values privately into backend/.env.
# These placeholders will not start a working connection.
SUPABASE_URL=https://<DEVELOPMENT_PROJECT_REF>.supabase.co
SUPABASE_PUBLISHABLE_KEY=<DEVELOPMENT_PUBLISHABLE_KEY_FROM_APPROVED_CHANNEL>
CORS_ORIGINS=["http://127.0.0.1:5173","http://localhost:5173"]
REQUEST_TIMEOUT_SECONDS=5
CONVERSATION_MODE=disabled
STORY_GENERATION_MODE=disabled
# The dedicated run_mobile_dev.py launcher selects free conversation/story mocks.
# Audio simulation requires its explicit --simulate-transcription CLI flag.
# Do not add service-role keys, database passwords or AI secrets to mobile JSON.
