# Backend values override the existing root VITE_SUPABASE_* development values.
# Copy this file to backend/.env; never commit credentials.
SUPABASE_URL=
SUPABASE_PUBLISHABLE_KEY=
CORS_ORIGINS=["http://localhost:8080","http://127.0.0.1:8080","http://localhost:5173","http://127.0.0.1:5173"]
REQUEST_TIMEOUT_SECONDS=5
# Per-process safeguards; review shared edge/distributed controls before hosting.
API_MAX_CONCURRENT_REQUESTS=64
API_REQUESTS_PER_MINUTE=120
# Opt in to explicitly labelled, deterministic simulation. No AI API calls.
CONVERSATION_MODE=disabled
STORY_GENERATION_MODE=disabled
# Day 12: evaluation-only adapters, NOT a live public API switch.
# Key presence is not spending approval. Keep disabled until written approval.
AI_PROVIDER_MODE=disabled
OPENAI_API_KEY=
OPENAI_TEXT_MODEL=
OPENAI_VERIFIER_MODEL=
OPENAI_TRANSCRIPTION_MODEL=gpt-4o-mini-transcribe
OPENAI_TIMEOUT_SECONDS=30
# Absolute, private approval/ledger paths; no approval file is created by setup.
LIVE_AI_APPROVAL_PATH=
AI_USAGE_LEDGER_PATH=
# Optional audited cumulative/per-user policy; never grants spending by itself.
AI_BUDGET_POLICY_PATH=

# Separate real-v2 application. Setup alone never activates paid providers.
# See docs/milestone1-real-integration.md. Never put a server secret in Expo.
REAL_AI_ENABLED=false
# Restrict paid actions to explicitly typed chat; voice and writing remain paused.
REAL_AI_TEXT_ONLY=false
# Independent feature switches remain subordinate to the global gate and budget.
REAL_AI_TRANSCRIPTION_ENABLED=true
REAL_AI_CONVERSATION_ENABLED=true
REAL_AI_WRITING_ENABLED=true
REAL_AI_SPEECH_ENABLED=true
SUPABASE_SECRET_KEY=
REAL_AI_TRANSCRIPTION_MODEL=
REAL_AI_SPEECH_MODEL=
REAL_AI_VOICE=marin
REAL_AI_USAGE_LOG_PATH=
# Optional encrypted, restart-safe speech storage. Key must stay server-only.
# Retention cannot exceed the current database's one-hour maximum.
REAL_AI_SPEECH_STORAGE_PATH=
REAL_AI_SPEECH_ENCRYPTION_KEY=
REAL_AI_SPEECH_RETENTION_SECONDS=300
REAL_AI_SPEECH_MAX_BYTES=32000000
