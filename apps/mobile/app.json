{
  "expo": {
    "name": "Memy",
    "slug": "memy-mobile",
    "version": "0.1.0",
    "scheme": "memy-foundation",
    "userInterfaceStyle": "light",
    "platforms": [
      "android",
      "ios"
    ],
    "plugins": [
      "expo-router",
      [
        "expo-audio",
        {
          "microphonePermission": "Memy uses the microphone only when you choose to record a fictional test sample. Memy använder mikrofonen bara när du väljer att spela in ett fiktivt test.",
          "recordAudioAndroid": true,
          "enableBackgroundRecording": false,
          "enableBackgroundPlayback": false
        }
      ]
    ],
    "experiments": {
      "typedRoutes": true
    },
    "android": {
      "permissions": [],
      "blockedPermissions": [
        "android.permission.CAMERA",
        "android.permission.READ_CONTACTS",
        "android.permission.ACCESS_FINE_LOCATION"
      ]
    }
  }
}
