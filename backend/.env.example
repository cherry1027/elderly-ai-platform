# Backend values override the existing root VITE_SUPABASE_* development values.
# Copy this file to backend/.env; never commit credentials.
SUPABASE_URL=
SUPABASE_PUBLISHABLE_KEY=
CORS_ORIGINS=["http://localhost:8080","http://127.0.0.1:8080","http://localhost:5173","http://127.0.0.1:5173"]
REQUEST_TIMEOUT_SECONDS=5
# Per-process safeguards; review shared edge/distributed controls before hosting.
API_MAX_CONCURRENT_REQUESTS=64
API_REQUESTS_PER_MINUTE=120
# Opt in to explicitly labelled, deterministic simulation. No AI API calls.
CONVERSATION_MODE=disabled
STORY_GENERATION_MODE=disabled
# Day 12: evaluation-only adapters, NOT a live public API switch.
# Key presence is not spending approval. Keep disabled until written approval.
AI_PROVIDER_MODE=disabled
OPENAI_API_KEY=
OPENAI_TEXT_MODEL=
OPENAI_VERIFIER_MODEL=
OPENAI_TRANSCRIPTION_MODEL=gpt-4o-mini-transcribe
OPENAI_TIMEOUT_SECONDS=30
# Absolute, private approval/ledger paths; no approval file is created by setup.
LIVE_AI_APPROVAL_PATH=
AI_USAGE_LEDGER_PATH=
