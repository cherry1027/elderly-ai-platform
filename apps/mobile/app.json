{
  "expo": {
    "name": "Memy",
    "slug": "memy-mobile",
    "version": "0.1.0",
    "scheme": "memy-foundation",
    "userInterfaceStyle": "light",
    "platforms": [
      "android",
      "ios"
    ],
    "plugins": [
      "expo-router"
    ],
    "experiments": {
      "typedRoutes": true
    },
    "android": {
      "permissions": [],
      "blockedPermissions": [
        "android.permission.RECORD_AUDIO",
        "android.permission.CAMERA",
        "android.permission.READ_CONTACTS",
        "android.permission.ACCESS_FINE_LOCATION"
      ]
    }
  }
}
