# Sanitized example only. Keep actual values in ignored private files or the
# host's secret manager; never copy server credentials into an Expo build.
STAGING_ORIGIN=https://memy-backend-staging.onrender.com
STAGING_TLS_MODE=render-edge
STAGING_STATE_DIR=/var/data/memy
STAGING_BOOTSTRAP_AI_OFF=true
STAGING_ENABLE_REAL_AI=false
STAGING_BACKUP_INTERVAL_SECONDS=3600
STAGING_BACKUP_KEEP=24
# Replace with the reviewed static web origin before phone browser tests.
CORS_ORIGINS=[]
SUPABASE_URL=https://edbkuunyeyxnyenmmqud.supabase.co
SUPABASE_PUBLISHABLE_KEY=
SUPABASE_SECRET_KEY=
OPENAI_API_KEY=
REAL_AI_ENABLED=false
REAL_AI_TEXT_ONLY=false
# Fast-path transport flags never enable paid AI by themselves.
REAL_AI_COMBINED_TURN_ENABLED=true
REAL_AI_STREAM_TURN_ENABLED=true
OPENAI_TEXT_MODEL=gpt-6.1-terra
OPENAI_VERIFIER_MODEL=gpt-6.1-terra
REAL_AI_TRANSCRIPTION_MODEL=gpt-transcribe
REAL_AI_SPEECH_MODEL=gpt-realtime-2.1-mini
REAL_AI_VOICE=marin
LIVE_AI_APPROVAL_PATH=/var/data/memy/approval.json
AI_BUDGET_POLICY_PATH=/var/data/memy/budget-policy.json
AI_PILOT_COHORT_PATH=/var/data/memy/pilot-cohort.json
AI_USAGE_LEDGER_PATH=/var/data/memy/ledger.sqlite3
REAL_AI_USAGE_LOG_PATH=/var/data/memy/usage.jsonl
REAL_AI_SPEECH_STORAGE_PATH=/var/data/memy/speech.sqlite3
REAL_AI_SPEECH_ENCRYPTION_KEY=
REAL_AI_SPEECH_RETENTION_SECONDS=300
