{
  "expo": {
    "name": "Memy",
    "slug": "memy-mobile",
    "version": "0.1.0",
    "scheme": "memy-foundation",
    "userInterfaceStyle": "light",
    "platforms": [
      "android",
      "ios",
      "web"
    ],
    "plugins": [
      "expo-router",
      "expo-asset",
      [
        "expo-audio",
        {
          "microphonePermission": "Memy uses the microphone only when you choose to record a fictional test sample. Mina Minnen anv\u00e4nder mikrofonen bara n\u00e4r du v\u00e4ljer att spela in ett fiktivt test.",
          "recordAudioAndroid": true,
          "enableBackgroundRecording": false,
          "enableBackgroundPlayback": false
        }
      ]
    ],
    "experiments": {
      "typedRoutes": true
    },
    "android": {
      "permissions": [],
      "blockedPermissions": [
        "android.permission.CAMERA",
        "android.permission.READ_CONTACTS",
        "android.permission.ACCESS_FINE_LOCATION"
      ]
    }
  }
}
